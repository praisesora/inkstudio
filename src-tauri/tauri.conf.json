{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ink Studio",
  "version": "1.0.4",
  "identifier": "com.inkstudio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ink Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "maximized": true,
        "decorations": false,
        "additionalBrowserArgs": "--disable-features=StylusHandwritingWin,StylusHandwriting,msAbydos,msAbydosHandwritingAttr,msAbydosGestureSupport"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; font-src 'self' data:; media-src 'self' blob: data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost ws: wss: http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Sora",
    "shortDescription": "Collaborative Drawing Studio",
    "copyright": "Copyright © 2026 Sora",
    "license": "GPL-3.0",
    "licenseFile": "../LICENSE",
    "fileAssociations": [
      {
        "ext": ["ink"],
        "name": "Ink Studio Project",
        "description": "Ink Studio Project File",
        "role": "Editor"
      },
      {
        "ext": ["inkb"],
        "name": "Ink Studio Brush",
        "description": "Ink Studio Brush Preset File",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBFOUVGREQ3NkIyMDNERTYKUldUbVBTQnIxLzJlRGtHb1BvUWNNcDE4UklUeTByMXUrSjdFb2k1TmR3ZnpSeDhTYzIra3pCVlcK",
      "endpoints": [
        "https://github.com/praisesora/inkstudio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
